# LeafTally — environment variables
# Copy to .env and fill in values

# App
VITE_APP_NAME=LeafTally
VITE_APP_ENV=development          # development | staging | production
VITE_APP_URL=http://localhost:5173

# API (future backend)
VITE_API_URL=http://localhost:3000/api/v1
VITE_API_TIMEOUT=10000

# Feature flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_FIRS_LIVE=false       # Set true only when FIRS API key is configured

# External services (reference — set in CI secrets for production)
# FIRS_API_KEY=
# SENDGRID_API_KEY=
# PAYSTACK_PUBLIC_KEY=
